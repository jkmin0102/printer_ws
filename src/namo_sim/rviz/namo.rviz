Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Static map - movable obstacle excluded
      Enabled: true
      Value: true
      Alpha: 1.0
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Global costmap - real scan obstacles
      Enabled: true
      Value: true
      Alpha: 0.16
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Update Topic:
        Value: /global_costmap/costmap_updates
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Value: true
      Alpha: 0.08
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Update Topic:
        Value: /local_costmap/costmap_updates
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3 Waffle Pi
      Enabled: true
      Value: true
      Alpha: 1.0
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0.0
      TF Prefix: ""
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR - actual scan
      Enabled: true
      Value: true
      Alpha: 1.0
      Color: 30; 210; 130
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0.0
      Selectable: true
      Use Fixed Frame: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Filter size: 10
    - Class: rviz_default_plugins/Path
      Name: HYPOTHETICAL after MOCK REMOVE
      Enabled: true
      Value: true
      Alpha: 0.9
      Color: 35; 110; 255
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.055
      Pose Style: None
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.07
      Topic:
        Value: /namo/clear_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Filter size: 10
    - Class: rviz_default_plugins/Path
      Name: DETOUR with observed obstacle
      Enabled: true
      Value: true
      Alpha: 1.0
      Color: 255; 140; 20
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.055
      Pose Style: None
      Offset:
        X: 0.0
        Y: 0.0
        Z: 0.1
      Topic:
        Value: /namo/detour_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Filter size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: NAMO - detection decision times state MOCK REMOVE
      Enabled: true
      Value: true
      Namespaces: {}
      Topic:
        Value: /namo/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Filter size: 10
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 255; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0.0
      Near Clip Distance: 0.01
      Scale: 52.0
      Target Frame: map
      X: 3.0
      Y: 1.5
    Saved: ~
Window Geometry:
  Width: 640
  Height: 720
  X: 640
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true

<sdf version="1.6">
  <!-- Empty can: user dimensions; 0.015 kg and friction are simulation assumptions,
       not measurements. Thin-wall cylindrical inertia approximation. -->
  <model name="namo_can">
    <static>false</static><allow_auto_disable>false</allow_auto_disable>
    <link name="body">
      <gravity>true</gravity>
      <inertial><mass>0.015</mass><inertia>
        <ixx>0.00002746875</ixx><iyy>0.00002746875</iyy><izz>0.000009375</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia></inertial>
      <collision name="can_collision"><geometry><cylinder>
        <radius>0.025</radius><length>0.135</length>
      </cylinder></geometry><surface>
        <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
        <contact><ode><kp>100000</kp><kd>1</kd><min_depth>0.0001</min_depth><max_vel>0.05</max_vel></ode></contact>
        <bounce><restitution_coefficient>0</restitution_coefficient><threshold>0.01</threshold></bounce>
      </surface></collision>
      <!-- Code-generated visual approximation; no effect on physical geometry,
           perception class/confidence, or object pose. Re-evaluate actual RGB. -->
      <visual name="red_body"><geometry><mesh>
        <uri>model://namo_manipulation/models/cola_side.dae</uri>
        <scale>1 1 1</scale>
      </mesh></geometry>
      </visual>
      <visual name="top"><pose>0 0 0.0665 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
      </visual>
      <visual name="bottom"><pose>0 0 -0.0665 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>

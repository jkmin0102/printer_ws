Panels:
- Class: namo_rviz/StatusPanel
  Name: NAMO 상태
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Name: 정적 지도 (캔 제외)
    Enabled: true
    Value: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: true
    Use Timestamp: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Map
    Name: 전역 costmap (실제 LiDAR 관측)
    Enabled: false
    Value: false
    Alpha: 0.16
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Update Topic:
      Value: /global_costmap/costmap_updates
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Map
    Name: 근거리 costmap
    Enabled: false
    Value: false
    Alpha: 0.08
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Update Topic:
      Value: /local_costmap/costmap_updates
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/RobotModel
    Name: Waffle Pi + OpenMANIPULATOR-X
    Enabled: true
    Value: true
    Alpha: 1.0
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
    Visual Enabled: true
    Collision Enabled: false
    Update Interval: 0.0
    TF Prefix: ''
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
  - Class: rviz_default_plugins/LaserScan
    Name: 초록 점 - 실제 LiDAR
    Enabled: true
    Value: true
    Alpha: 1.0
    Color: 30; 210; 130
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 3
    Size (m): 0.02
    Decay Time: 0.0
    Selectable: true
    Use Fixed Frame: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Filter size: 10
  - Class: rviz_default_plugins/Path
    Name: '파랑: 제거 후 후보 경로'
    Enabled: true
    Value: true
    Alpha: 0.9
    Color: 35; 110; 255
    Buffer Length: 1
    Line Style: Billboards
    Line Width: 0.025
    Pose Style: None
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.07
    Topic:
      Value: /namo/clear_path
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
  - Class: rviz_default_plugins/Path
    Name: '주황: 우회 후보 경로'
    Enabled: true
    Value: true
    Alpha: 1.0
    Color: 255; 140; 20
    Buffer Length: 1
    Line Style: Billboards
    Line Width: 0.025
    Pose Style: None
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.1
    Topic:
      Value: /namo/detour_path
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
  - Class: rviz_default_plugins/MarkerArray
    Name: 출발·판단·목표·적치 위치
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /namo/markers
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
  - Class: rviz_default_plugins/Path
    Name: '보라: 현재 주행 경로 · 계속 갱신'
    Enabled: true
    Value: true
    Alpha: 0.9
    Color: 180; 40; 220
    Buffer Length: 1
    Line Style: Billboards
    Line Width: 0.018
    Pose Style: None
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.13
    Topic:
      Value: /plan
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 255; 255; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0.0
      Near Clip Distance: 0.01
      Scale: 45.0
      Target Frame: map
      X: 2.3
      Y: 1.7
    Saved: null
Window Geometry:
  Width: 800
  Height: 720
  X: 640
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: true
